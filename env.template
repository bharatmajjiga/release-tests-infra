# ============================================================
# release-tests-infra — environment configuration
# ============================================================
#
# Setup:
#   cp env.template .env
#   source .env
# ============================================================

# --- Cluster connection ---
# For Cluster Platforms
# CLUSTER_PLATFORMS=true  (required: APISERVER, OC_TOKEN, CLUSTER_CA_CERT)
# CLUSTER_NAME=
# APISERVER=
# OC_TOKEN=
# CLUSTER_CA_CERT=
# KUBEADMIN_PASSWORD=
# KUBEADMIN_USER=kubeadmin
# USER_PASSWORD=

# Any other clusters
# CLUSTER_PLATFORMS=false (required: APISERVER, KUBEADMIN_PASSWORD)
# CLUSTER_NAME=
# APISERVER=
# KUBEADMIN_PASSWORD=
# KUBEADMIN_USER=kubeadmin
# USER_PASSWORD=

# --- Operator configuration ---
ARCH=
CATALOG_SOURCE=
CHANNEL=
OPERATOR_VERSION=
OPERATOR_ENVIRONMENT=
KONFLUX_INDEX_IMAGE=
INSTALL_PIPELINES_OPERATOR=
INSTALL_LOGGING_OPERATOR=
INSTALL_SERVERLESS_OPERATOR=
UNINSTALL_PIPELINES_OPERATOR=
TAGS=
TEST_SUITES="release-tests-versions,release-tests-pipelines,release-tests-triggers,release-tests-triggers-tls,release-tests-chains,release-tests-pac,release-tests-pac-github,release-tests-pac-gitlab,release-tests-results,release-tests-metrics,release-tests-rbac,release-tests-addon,release-tests-auto-prune,release-tests-manual-approval,release-tests-ecosystem,release-tests-ecosystem-multiarch,release-tests-ecosystem-s2i"
SEND_SLACK_NOTIFICATION=

# For Gauge Framework
TEST_FRAMEWORK=gauge
GIT_RELEASE_TESTS_BRANCH=

# For Ginkgo Framework
TEST_FRAMEWORK=ginkgo
GIT_RELEASE_TESTS_GINKGO_BRANCH=

# release-tests-infra branch
GIT_INFRA_BRANCH=

# --- Container image for test runner ---
IMAGE=

# --- TKN CLI download URL ---
TKN_DOWNLOAD_URL=https://developers.redhat.com/content-gateway/file/pub/cgw/pipelines/1.22.0/tkn-linux-amd64.tar.gz

# --- Secret credential source (Vault)---
# VAULT_TOKEN=
# VAULT_ADDR=
# VAULT_KV_MOUNT=
# VAULT_KV_PATH=

# --- Secret credential source (local) ---
# local = non-empty vars below | vault = OIDC login + Vault KV (./scripts/create-secrets.sh --vault-login)
CRED_SOURCE=local

# --- GitHub (PAC) — PAC_GITHUB_TOKEN can come from Vault GITHUB_TOKEN; PAC_GITHUB_ORG must be set here ---
GITHUB_TOKEN=
PAC_GITHUB_TOKEN=
PAC_GITHUB_ORG=
PAC_GITHUB_WEBHOOK_TOKEN=

# --- GitLab (PAC) ---
GITLAB_TOKEN=
GITLAB_GROUP_NAMESPACE=
GITLAB_PROJECT_ID=
GITLAB_WEBHOOK_TOKEN=

# --- Quay ---
QUAY_USER=
QUAY_PASS=
QUAY_API_TOKEN=

# --- Brew ---
BREW_USER=
BREW_PASS=

# --- AWS ---
AWS_ACCESS_KEY=
AWS_ACCESS_SECRET=

# --- Red Hat subscription ---
SUBSCRIPTION_USERNAME=
SUBSCRIPTION_PASSWORD=

# --- Report Portal ---
RP_URL=
RP_PROJECT=
RP_ROBOT_UUID=
RP_SUPERADMIN_UUID=

# --- Polarion ---
POLARION_USERNAME=
POLARION_PASSWORD=
POLARION_PROJECT=

# --- Slack ---
SLACK_WEBHOOK_URL=

# --- Mac mini ---
MAC_HOSTNAME=
MAC_USERNAME=
MAC_PASSWORD=

# --- Uploader (pipeline uploads results to https://artifacts.ospqa.com/CI/) ---
# UPLOADER_HOST=https://artifacts.ospqa.com
# UPLOADER_USERNAME=
# UPLOADER_PASSWORD=
